# ========================================================
# Konfigurasi Pengiriman Email OTP Riil ke Kotak Masuk
# Pilih salah satu opsi di bawah:
# ========================================================

# OPSI A: Menggunakan Gmail SMTP (Paling Mudah)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email_anda@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Layanan TTE BSrE <email_anda@gmail.com>

# OPSI B: Menggunakan Resend API (Tanpa Akun Gmail)
# Daftar gratis di https://resend.com lalu buat API Key:
# RESEND_API_KEY=re_1234567890abcdef
