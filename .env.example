# ========================================================
# KONFIGURASI STANDAR PRODUKSI (ARSIGN PQC)
# Platform TTE Pascakuantum (NIST FIPS 204)
# ========================================================
APP_ENV=production
PORT_PROD=8080
PORT_PROC=8081
PORT_ADMIN=8082
# WAJIB disetel. Tanpa nilai ini layanan administrator menolak semua permintaan.
# Bangkitkan nilai acak, contoh: openssl rand -base64 32
ADMIN_SECRET_KEY=
DB_PATH=pqc_arsign.db

# Direktori penyimpanan material Otoritas Sertifikasi (JANGAN di-commit)
ARSIGN_CA_DIR=ca_keys

# Titik distribusi CRL yang disematkan pada sertifikat terbitan
ARSIGN_CRL_URL=http://localhost:8080/api/v1/ca/crl?format=pem

# Daftar origin yang diizinkan memanggil API lintas asal (dipisahkan koma)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

# --------------------------------------------------------
# EMAIL OTP TRANSAKSIONAL VIA RESEND
# Domain: smallcircle.web.id
# --------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=ARSign <no-reply@smallcircle.web.id>
