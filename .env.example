# Konfigurasi Pengiriman Email OTP Resmi BSrE
# Jika variabel ini diisi, sistem akan otomatis mengirimkan email nyata via server SMTP.
# Jika kosong, sistem tetap berjalan aman di memory & log server tanpa menampilkan OTP di UI.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=layanan.tte.bsre@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Layanan TTE BSrE <layanan.tte.bsre@gmail.com>
